APP_NAME="Central PDF Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pdf.as7th.com
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pdf_service
DB_USERNAME=pdf_service
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# When Redis is available, prefer it for queue/cache:
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@as7th.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Gotenberg (Chromium PDF engine) - must stay on loopback
# ---------------------------------------------------------------------------
GOTENBERG_URL=http://127.0.0.1:3000
GOTENBERG_CONNECT_TIMEOUT=10
GOTENBERG_TIMEOUT=90
GOTENBERG_RETRY_TIMES=1
GOTENBERG_RETRY_SLEEP_MS=500

# ---------------------------------------------------------------------------
# Document generation / storage
# ---------------------------------------------------------------------------
PDF_DISK=local
PDF_DOCUMENT_PATH=documents
PDF_DEFAULT_FORMAT=A4
PDF_DEFAULT_ORIENTATION=portrait
PDF_DOCUMENT_RETENTION_DAYS=30
PDF_MAX_PAYLOAD_KB=1024
PDF_MAX_TEMPLATE_BYTES=2097152
PDF_MAX_UPLOAD_KB=5120
PDF_SIGNED_URL_TTL=30
PDF_QUEUE_CONNECTION=
PDF_QUEUE_NAME=documents
PDF_QUEUE_TRIES=3
PDF_QUEUE_TIMEOUT=180
PDF_QUEUE_BACKOFF=15

# Remote image variables are fetched through an SSRF guard; disable entirely
# if external images are not needed.
PDF_ALLOW_REMOTE_IMAGES=true
PDF_MAX_REMOTE_IMAGE_BYTES=5242880
PDF_REMOTE_IMAGE_TIMEOUT=10

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=60
API_KEY_PREFIX=pdfsvc
API_IDEMPOTENCY_TTL_HOURS=24
# Generate once and keep stable: openssl rand -hex 32
API_KEY_HASH_SALT=

# Used only by the database seeder; leave the password empty to generate a
# random one that is printed once by `php artisan db:seed`.
ADMIN_EMAIL=admin@as7th.com
ADMIN_PASSWORD=
