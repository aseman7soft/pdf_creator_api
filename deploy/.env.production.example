# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Central PDF Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pdf.as7th.com
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging â€” Ø¯Ø± production Ø³Ø·Ø­ warning Ø¨Ø±Ø§ÛŒ Ú©Ø§Ù‡Ø´ Ø­Ø¬Ù… Ùˆ Ù†Ø´Øª Ø¯Ø§Ø¯Ù‡
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database â€” MySQL 8 (Ú©Ø§Ø±Ø¨Ø± Ø§Ø®ØªØµØ§ØµÛŒ Ø¨Ø§ Ø­Ø¯Ø§Ù‚Ù„ Ø¯Ø³ØªØ±Ø³ÛŒØŒ Ù†Ù‡ root)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pdf_service
DB_USERNAME=pdf_service
DB_PASSWORD=<STRONG_DB_PASSWORD>

# -----------------------------------------------------------------------------
# Session â€” Ù¾Ù†Ù„ Ù…Ø¯ÛŒØ±ÛŒØªØ› Ú©ÙˆÚ©ÛŒ ÙÙ‚Ø· Ø±ÙˆÛŒ HTTPS
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Storage / Queue / Cache
# - database Ø¨Ø±Ø§ÛŒ Ø±Ø§Ù‡â€ŒØ§Ù†Ø¯Ø§Ø²ÛŒ Ø³Ø§Ø¯Ù‡Ø› Ø¨Ø±Ø§ÛŒ Ø¨Ø§Ø± Ø²ÛŒØ§Ø¯ Redis ØªÙˆØµÛŒÙ‡ Ù…ÛŒâ€ŒØ´ÙˆØ¯.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (Ø§Ø®ØªÛŒØ§Ø±ÛŒ â€” Ø¯Ø± ØµÙˆØ±Øª Ù†ØµØ¨ Ùˆ ØªÙ†Ø¸ÛŒÙ… Redis Ø§ÛŒÙ† Ø¨Ø®Ø´ Ø±Ø§ ÙØ¹Ø§Ù„ Ú©Ù†ÛŒØ¯)
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@as7th.com"
