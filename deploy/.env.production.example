# -----------------------------------------------------------------------------
# Gotenberg (Chromium PDF Engine)
# - ÙÙ‚Ø· loopback. Ù‡Ø±Ú¯Ø² Ø¢Ø¯Ø±Ø³ Ø¹Ù…ÙˆÙ…ÛŒ ÛŒØ§ Ø§Ø¹ØªØ¨Ø§Ø±Ù†Ø§Ù…Ù‡ Ù†Ú¯Ø°Ø§Ø±ÛŒØ¯.
# - Gotenberg Ø§Ø² Ù‚Ø¨Ù„ Ø±ÙˆÛŒ Ø³Ø±ÙˆØ± Ù†ØµØ¨ Ø§Ø³ØªØ› Ø¢Ù† Ø±Ø§ ØªØºÛŒÛŒØ±/Ø±ÛŒâ€ŒØ§Ø³ØªØ§Ø±Øª Ù†Ú©Ù†ÛŒØ¯.
# -----------------------------------------------------------------------------
GOTENBERG_URL=http://127.0.0.1:3000
GOTENBERG_CONNECT_TIMEOUT=10
GOTENBERG_TIMEOUT=90
GOTENBERG_RETRY_TIMES=1
GOTENBERG_RETRY_SLEEP_MS=500

# -----------------------------------------------------------------------------
# Document generation / private storage
# -----------------------------------------------------------------------------
PDF_DISK=local
PDF_DOCUMENT_PATH=documents
PDF_DEFAULT_FORMAT=A4
PDF_DEFAULT_ORIENTATION=portrait
PDF_DOCUMENT_RETENTION_DAYS=30
PDF_MAX_PAYLOAD_KB=1024
PDF_MAX_TEMPLATE_BYTES=2097152
PDF_MAX_UPLOAD_KB=5120
PDF_SIGNED_URL_TTL=30
PDF_QUEUE_CONNECTION=
PDF_QUEUE_NAME=documents
PDF_QUEUE_TRIES=3
PDF_QUEUE_TIMEOUT=180
PDF_QUEUE_BACKOFF=15
PDF_ALLOW_REMOTE_IMAGES=true
PDF_MAX_REMOTE_IMAGE_BYTES=5242880
PDF_REMOTE_IMAGE_TIMEOUT=10

# -----------------------------------------------------------------------------
# API â€” Ø§Ø­Ø±Ø§Ø² Ù‡ÙˆÛŒØª Bearer Ø¨Ø§ API Key
# -----------------------------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=60
API_KEY_PREFIX=pdfsvc
API_IDEMPOTENCY_TTL_HOURS=24

# HMAC salt Ú©Ù„ÛŒØ¯Ù‡Ø§ÛŒ API â€” ÙÙ‚Ø· ÛŒÚ©â€ŒØ¨Ø§Ø± ØªÙˆÙ„ÛŒØ¯ Ùˆ Ø¨Ø±Ø§ÛŒ Ù‡Ù…ÛŒØ´Ù‡ Ø«Ø§Ø¨Øª Ù†Ú¯Ù‡ Ø¯Ø§Ø±ÛŒØ¯:
#   openssl rand -hex 32
# Ø§Ú¯Ø± Ø®Ø§Ù„ÛŒ Ø¨Ù…Ø§Ù†Ø¯ØŒ APP_KEY Ø§Ø³ØªÙØ§Ø¯Ù‡ Ù…ÛŒâ€ŒØ´ÙˆØ¯Ø› Ø§Ù…Ø§ Ù…Ù‚Ø¯Ø§Ø± Ù…Ø³ØªÙ‚Ù„ Ùˆ ØªØ«Ø¨ÛŒØªâ€ŒØ´Ø¯Ù‡ Ø§Ù…Ù†â€ŒØªØ± Ø§Ø³Øª.
API_KEY_HASH_SALT=<OUTPUT_OF_openssl_rand_hex_32>

